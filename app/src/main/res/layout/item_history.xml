<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_cyber_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row (Always visible) -->
    <LinearLayout
        android:id="@+id/layoutItemHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivHistoryThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:background="#161616"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Tsubaki Flash • 1104 x 1824"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Prompt..."
                android:textColor="#B0B0B0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="2026-10-15 12:00:00"
                android:textColor="#757575"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivExpandIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <!-- Expandable Detailed View -->
    <LinearLayout
        android:id="@+id/layoutExpandedDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="#222222" />

        <!-- Danh sách từng ảnh riêng biệt (Không gộp chung) -->
        <LinearLayout
            android:id="@+id/layoutHistoryImagesFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Thông tin Prompt Gốc -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Prompt Gốc:"
            android:textColor="#888888"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvHistoryFullOriginalPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/btnHistoryCopyOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cyber_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="7dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_copy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sao Chép Prompt Gốc"
                android:textColor="#E0E0E0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Thông tin Prompt Server Sửa -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prompt Máy Chủ Tối Ưu:"
            android:textColor="#888888"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvHistoryFullServerPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:textColor="#81C784"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/btnHistoryCopyServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_cyber_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="7dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_copy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sao Chép Prompt Tối Ưu"
                android:textColor="#81C784"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
